{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thai Flashcards dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourceRevision",
    "sourceSpreadsheet",
    "topics",
    "cards"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    },
    "sourceSpreadsheet": {
      "const": "Thai Flash Cards"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entryType",
          "topics",
          "thai",
          "phonetic",
          "english",
          "exampleThai",
          "examplePhonetic",
          "exampleEnglish",
          "exampleLiteral",
          "dateAdded",
          "position"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "entryType": {
            "enum": ["Word", "Expression", "Particle", "Structure", "Word component"]
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "thai": {
            "type": "string",
            "minLength": 1
          },
          "phonetic": {
            "type": "string",
            "minLength": 1
          },
          "english": {
            "type": "string",
            "minLength": 1
          },
          "exampleThai": {
            "type": "string",
            "pattern": "^[^\\[]*\\[[^\\[\\]]+\\][^\\]]*$"
          },
          "exampleEnglish": {
            "type": "string",
            "pattern": "^[^\\[]*\\[[^\\[\\]]+\\][^\\]]*$"
          },
          "exampleLiteral": {
            "type": "string",
            "pattern": "^[^\\[]*\\[[^\\[\\]]+\\][^\\]]*$"
          },
          "dateAdded": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "examplePhonetic": {
            "type": "string",
            "pattern": "^[^\\[]*\\[[^\\[\\]]+\\][^\\]]*$"
          }
        }
      }
    }
  }
}
